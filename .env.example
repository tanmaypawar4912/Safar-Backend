
PORT=5000

MONGODB_URI=

# Use two different random secrets (at least 32 characters in production).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLIENT_URL=http://localhost:5173
# Optional exact additional origins, comma-separated. Never use * with cookies.
CLIENT_URLS=

MAPBOX_ACCESS_TOKEN=

# Cloudinary driver-media storage. Provide these three values OR CLOUDINARY_URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

NODE_ENV=development

# Optional: set only when deployed behind a trusted reverse proxy.
# Use the exact proxy hop count given by your hosting provider; do not use "true".
TRUST_PROXY=

# Optional booking / dispatch notification email (SMTP). If unset, booking
# operations still work, but email notifications are skipped and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Payment gateway (Razorpay). Keep secrets private; online payment stays disabled until configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Default COD route-distance cap; admin can override it in the dashboard.
COD_MAX_DISTANCE_KM=25
