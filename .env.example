
PORT=5000

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLIENT_URL=http://localhost:5173

MAPBOX_ACCESS_TOKEN=

NODE_ENV=development

# Optional booking / dispatch notification email (SMTP). If unset, booking
# operations still work, but email notifications are skipped and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Payment gateway (Razorpay). Keep secrets private; online payment stays disabled until configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Default COD route-distance cap; admin can override it in the dashboard.
COD_MAX_DISTANCE_KM=25
